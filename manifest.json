{
  "manifest_version": 3,
  "name": "Copy Clean Link - Remove URL Tracking",
  "version": "2.0.0",
  "description": "Copy links without tracking: removes UTM & fbclid, shortens Amazon links, unwraps redirects. No data collected, works offline.",
  "permissions": [
    "contextMenus",
    "clipboardWrite",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "copy-clean-url": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy clean URL of current tab"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Copy Clean Link"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
